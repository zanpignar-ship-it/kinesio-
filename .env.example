# Application connection (role subject to row-level security). Never a superuser.
DATABASE_URL=postgres://rentora_app:rentora_app_dev@localhost:5432/rentora
# Schema owner, used ONLY by the migration runner and seed scripts.
DATABASE_OWNER_URL=postgres://rentora_owner:rentora_owner_dev@localhost:5432/rentora
# Test databases (integration tests reset this database)
TEST_DATABASE_URL=postgres://rentora_app:rentora_app_dev@localhost:5432/rentora_test
TEST_DATABASE_OWNER_URL=postgres://rentora_owner:rentora_owner_dev@localhost:5432/rentora_test
# Public base URL (used for QR passport links)
APP_URL=http://localhost:3000
# Integrations not yet configured (Phase 3+). Leave empty until credentials exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
